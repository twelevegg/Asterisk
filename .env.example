# Address Asterisk should advertise in SDP/SIP (host reachable by clients)
# - Same Wi-Fi test: your laptop Wi-Fi IPv4 (e.g., 192.168.10.111)
# - Remote test: Tailscale IP (e.g., 100.x.y.z)
# - AWS: Elastic IP or a fixed public IP behind a domain
ADVERTISE_ADDR=

# Networks considered "local" for NAT decisions (comma-separated CIDRs)
# IMPORTANT: Do NOT include Docker ranges like 172.16.0.0/12 on Windows Docker Desktop.
# Include only client networks + optional Tailscale range.
LOCAL_NETS=
